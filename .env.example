# Faith-El ERP — environment template
# Copy to .env and adjust:   cp .env.example .env
# .env is UNTRACKED on purpose (it carries the email-bridge secret).

# Canonical database URL — shared by EVERY runtime in this repo:
# the Next.js app (src/lib/db.ts), scripts/supervisor.js, and the whole
# Python stack (agents, email bridge, dashboard). Must be SQLAlchemy-style:
#   sqlite:///relative/path.db   (relative to the directory you launch from —
#                                use only if every service starts at repo root)
#   sqlite:////absolute/path.db  (safest — unambiguous for all services)
COFFEE_DATABASE_URL=sqlite:///state/coffee_export.db

# Prisma CLI ONLY (prisma db push / generate / migrate). Prisma uses its own
# `file:` format relative to prisma/schema.prisma. The Python stack must NOT
# read this variable (it used to crash SQLAlchemy at import time with
# "Could not parse SQLAlchemy URL" before the fallback was removed).
DATABASE_URL=file:../state/coffee_export.db

# Optional explicit per-process DB override for the Next.js app (wins over
# COFFEE_DATABASE_URL; used by the hermetic test runner). If set, the target
# must exist — the app refuses to silently fall back to another database.
# DATABASE_PATH=state/coffee_export.db

# Email bridge (Python EmailGateway on the mini-services side).
# Two-way masked email is BLOCKED until real relay credentials are configured —
# never fake delivery with Gmail-to-Gmail in tests or demos.
EMAIL_BRIDGE_URL=http://localhost:8000
EMAIL_BRIDGE_SECRET=change-me-set-a-real-secret-outside-local-dev

# ── Real email delivery (Resend) — Phase 2 configuration ────────────────
# All three variables below are read by the Python bridge
# (coffee_export/coffee_export/messaging/providers/resend.py). Set them in
# the environment of the process running the bridge (uvicorn), NEVER in
# client-side code, and never commit real values to Git.

# Outbound: Resend API key (re_xxx). Missing/empty => the provider runs in
# clearly-labeled DRY-RUN mode (messages stored, never delivered, ids
# prefixed "dry-run-"). Create a dedicated key with the narrowest
# permission/domain scope in the Resend dashboard.
# RESEND_API_KEY=

# Inbound: Resend webhook signing secret ("whsec_...", Resend dashboard →
# Webhooks). The bridge verifies EVERY inbound webhook with the Svix scheme
# (svix-id + svix-timestamp + svix-signature headers, HMAC-SHA256/base64
# over "{svix-id}.{ts}.{body}") and rejects anything older than 5 minutes
# (replay protection). Missing secret => inbound webhooks are REJECTED
# (fail closed). The public webhook URL to configure in Resend:
#   https://<your-bridge-host>/webhooks/email/inbound
# RESEND_WEBHOOK_SECRET=

# Masked-address domain (e.g. mail.your-domain.com). Buyers see and reply to
# addresses like marcus.bell@<this domain>. It must be a domain whose MX/
# inbound routing you control in Resend. CHANGING IT LATER: existing threads
# and messages keep their stored masked addresses (nothing is erased or
# orphaned in the DB), but mail sent to OLD masked addresses will only keep
# arriving if you keep an inbound route (or catch-all forward) for the old
# domain in Resend. New conversations use the new domain.
INBOUND_EMAIL_DOMAIN=faithelexport.com

# Dev-only escape hatch (NOT for production): when "1", unsigned inbound
# webhooks and unauthenticated bridge calls are accepted with a loud warning.
# Without it, a missing RESEND_WEBHOOK_SECRET / EMAIL_BRIDGE_SECRET fails
# CLOSED. Local dev default: unset.
# EMAIL_ALLOW_UNSIGNED_WEBHOOKS=

# ── Buyer identity masking (Phase 4) ─────────────────────────────────────
# Secret from which the buyer-mask crypto keys are derived (HKDF-SHA256):
#   - HMAC lookup keys  (deterministic real-address -> registry resolution)
#   - AES-256-GCM key   (real buyer addresses encrypted at rest in the
#                        buyer_masks registry — the ONLY place they exist)
#   - alias derivation  (buyer.<12hex>@<INBOUND_EMAIL_DOMAIN>)
# REQUIRED for the bridge to send or process email (fail closed — without it
# the gateway refuses sends and rejects inbound rather than storing any
# buyer address in plaintext). Generate like:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER commit the real value; NEVER log it. ROTATION IS NOT AN ENV SWAP:
# lookup keys AND ciphertexts are derived from this secret, so changing the
# value without a re-encryption (rewrap) migration makes every existing
# registry row unresolvable (and the gateway would mint duplicate masks for
# the same buyers on their next first-contact send). The ONLY safe sequence
# is documented in docs/buyer-masking.md → "Key rotation runbook":
# audit → back up (DB + old secret) → design dual-secret rewrap → re-encrypt
# every buyer_masks row → verify (all rows decrypt + lookup keys recompute +
# aliases unchanged) → activate the new key → retain controlled rollback.
BUYER_MASK_SECRET=change-me-generate-a-real-secret
